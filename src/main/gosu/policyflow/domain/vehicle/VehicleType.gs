package policyflow.domain.vehicle

/**
 * Represents standard vehicle types for personal and commercial auto lines.
 */
public enum VehicleType {
  /**
   * Standard 4-door passenger sedan.
   */
  SEDAN,

  /**
   * Sport Utility Vehicle.
   */
  SUV,

  /**
   * Medium or heavy-duty utility truck.
   */
  TRUCK,

  /**
   * 2-door passenger coupe.
   */
  COUPE,

  /**
   * Standard commercial or passenger van.
   */
  VAN,

  /**
   * Two-wheeled motorcycle.
   */
  MOTORCYCLE
}
